# Server
PORT=4100

# Database (mysql or postgres)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=construct
DB_SSL=false

# OAuth — Construct Accounts
OAUTH_CLIENT_ID=spaces_portal
OAUTH_CLIENT_SECRET=your_client_secret_here
OAUTH_REDIRECT_URI=http://localhost:4100/api/auth/callback
OAUTH_AUTHORIZE_URL=https://accounts.lisaos.dev/oauth/authorize
OAUTH_TOKEN_URL=https://accounts.lisaos.dev/oauth/token
OAUTH_USERINFO_URL=https://accounts.lisaos.dev/api/me
OAUTH_SCOPE=profile email

# App URL
APP_URL=http://localhost:4100

# Space bundle signing (ECDSA P-256). The publish builder signs app.iife.js and
# writes build.signature + build.signKeyId into the bundled manifest.json; the
# host verifies it against the pinned public key in
# construct-app/frontend/space_loader/signature.ts (TRUSTED_SPACE_KEYS).
# Provide the PKCS8 PEM private key inline, OR point to a file (FILE wins only
# if PEM is empty). Leave both empty to publish UNSIGNED (current default).
# SPACE_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SPACE_SIGNING_KEY_FILE=/path/to/space-signing-marketplace-2026-05.pem
SPACE_SIGNING_KEY_ID=marketplace-2026-05

# Added 2026-09-08 from the deployment's keys
OAUTH_CLI_CLIENT_ID=dev_portal_cli
OAUTH_CLI_CLIENT_SECRET=change-me
STORAGE_ACCOUNT_ID=<account-id>
STORAGE_API_KEY=change-me
STORAGE_API_SECRET=change-me
STORAGE_BUCKET=construct
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://cdn.construct.space
INTERNAL_SHARED_SECRET=change-me
SOURCE_URL=http://source
ACCOUNTS_URL=http://accounts
MARKETPLACE_URL=http://marketplace-api
SPACE_SIGNING_KEY_PEM=change-me
